<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_trusted_calls_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_trusted_calls"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_trusted_calls_title"
            style="@style/TextAppearance.OldLauncher.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_trusted_calls_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_trusted_calls_all"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/home_trusted_calls_all"
            android:textAllCaps="false"
            android:textColor="@color/launcher_contacts"
            app:icon="@android:drawable/ic_menu_agenda"
            app:iconTint="@color/launcher_contacts" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_trusted_call_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal" />
</LinearLayout>
